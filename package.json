{
  "name": "pdf2md-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:serve": "npm run build && npm run preview",
    "clean:dev": "rm -rf node_modules/.vite && npm run dev",
    "eval:pdf2md": "tsx scripts/pdf2md-eval/run.ts",
    "test": "tsc -p tsconfig.test.json && tsx --test \"src/**/__tests__/*.test.ts\" \"scripts/**/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-advanced-cropper": "^0.20.1",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "diff-match-patch": "^1.0.5",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "mammoth": "^1.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}

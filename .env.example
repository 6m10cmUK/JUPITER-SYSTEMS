# フロントエンド環境変数
VITE_API_URL=http://localhost:8000

# 本番環境では以下のように設定
# VITE_API_URL=https://your-app.onrender.com

# Cloudflare Worker API（認証・R2・ルーム管理・シグナリング）
VITE_R2_WORKER_URL=https://your-worker.workers.dev

# Google OAuth2 クライアントID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend URL（アニメーション画像圧縮用、未設定時はフォールバック）
VITE_BACKEND_URL=http://localhost:8000

# Supabase（Adrastea バックエンド）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# true のとき本番ビルドでも Realtime / active_scene のデバッグログを出す（開発中は不要・npm run dev だけで十分）
# VITE_DEBUG_REALTIME=true
